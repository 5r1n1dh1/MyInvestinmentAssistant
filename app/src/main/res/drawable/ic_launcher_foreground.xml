<?xml version="1.0" encoding="utf-8"?>
<!--
  app/src/main/res/drawable/ic_launcher_foreground.xml

  The adaptive-icon foreground layer: a stylised end-of-day price chart.

  ### What it depicts, and why that
  A candlestick body over two wicks, on a baseline. This app is an **end-of-day** analysis
  tool — plan.md §1.3 is explicit that it is not a live-trading app — so the icon shows the
  thing the app actually reasons about: one completed session's bar. A rising arrow or a
  rocket would imply a direction claim, and plan.md §1.4 forbids exactly that framing.

  ### Why a *rising* body rather than a falling one
  This is the one place the icon could have misled, so it is worth being explicit. The candle is
  drawn rising because a launcher icon needs a readable silhouette, **not** because the app
  expects prices to rise. Nothing in the app infers direction from this image; there is no
  per-stock icon anywhere.

  ### Geometry: everything inside the 72dp safe zone
  Adaptive-icon guidelines put only the central 72x72dp of the 108x108dp canvas inside the
  guaranteed-visible circle; the outer 18dp on each side may be cropped by an OEM mask. Every
  coordinate below therefore stays within roughly 22..86 on both axes. The candle occupies
  x 40..62 and the baseline x 30..78, so nothing here can be clipped by the most aggressive
  mask in common use.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      The wick. Drawn behind the body so the body's fill wins where they overlap, and kept
      narrower (3.5 wide) than the body so it reads as a wick at 48dp rather than merging
      into a single block.
    -->
    <path
        android:fillColor="#FF9FC4F5"
        android:pathData="M48.25,28h3.5v40h-3.5z" />

    <!--
      The body: open 58, close 44, i.e. a rising session. Rounded joins are avoided on
      purpose — a crisp rectangle matches the chart language of the app itself, which draws
      the same shape on every candle.
    -->
    <path
        android:fillColor="#FF4ADE80"
        android:pathData="M39,44h22v22h-22z" />

    <!--
      The baseline: the "close of session" level every measured move is drawn from
      (plan.md §6.6). Rendered as two separated strokes rather than one continuous rule so
      the candle visibly *rests* on it instead of merging into it.
    -->
    <path
        android:fillColor="#FFCBD5E1"
        android:pathData="M30,69h19v3.5h-19z" />
    <path
        android:fillColor="#FFCBD5E1"
        android:pathData="M62,69h16v3.5h-16z" />

    <!--
      A second, shorter session to the left, at 40% opacity. It gives the silhouette depth at
      small sizes and signals "a series", not "one bar" — without crowding the safe zone
      because it sits in x 30..38, inside the 72dp circle.
    -->
    <path
        android:fillColor="#66E2E8F0"
        android:pathData="M33,52h5.5v17h-5.5z" />

    <!--
      A third to the right, dimmer still, completing the "several sessions" reading. Same
      reasoning; x 65..70.
    -->
    <path
        android:fillColor="#4DCBD5E1"
        android:pathData="M65,56h5.5v13h-5.5z" />
</vector>