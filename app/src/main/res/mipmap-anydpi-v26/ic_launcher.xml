<?xml version="1.0" encoding="utf-8"?>
<!--
  app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml

  The adaptive icon, for API 26+. `minSdk` is 31, so **every** supported device uses this file
  and the legacy `mipmap-*/ic_launcher.png` bitmaps are only a belt-and-braces fallback for a
  launcher that asks for them by density.

  Three layers, each doing one job:
    background   the gradient field, cropped freely by the OEM mask
    foreground   the candle, confined to the central 72dp safe zone
    monochrome   the hollow silhouette Android 13+ tints for themed icons

  Every path is a vector, so one file covers every density and there is no 5x set of PNGs to
  keep in sync with it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>